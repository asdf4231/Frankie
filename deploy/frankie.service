[Unit]
Description=Frankie course assistant

[Service]
Type=simple
WorkingDirectory=%h/frankie/Frankie-main
Environment="FRANKIE_DATA_DIR=%h/frankie/data"
Environment="FRANKIE_COURSE_WIKI_PATH=%h/frankie/course/llm_wiki"
EnvironmentFile=%h/frankie/deployment.env
ExecStart=%h/frankie/Frankie-main/.venv/bin/python -m uvicorn frankie.web:app --host 127.0.0.1 --port 7860
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
