# .env 模板 —— 复制为 .env 并填入真实值
# 规则：仅将机密密钥放这里。
# 其余配置优先从 config/settings.toml 加载，或通过环境变量覆盖。

DEEPSEEK_API_KEY=your_deepseek_api_key_here
FRANKIE_AUTH_SECRET=change-this-to-a-long-random-secret

# 可选环境变量（仅用于覆盖运行时目录 / 模型配置）：
# FRANKIE_DATA_DIR=./data
# FRANKIE_COURSE_WIKI_PATH=/path/to/llm_wiki
# FRANKIE_LLM_BASE_URL=https://api.deepseek.com
# FRANKIE_LLM_DEFAULT_MODEL=deepseek-flash
